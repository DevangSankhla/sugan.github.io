# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your_app_id

# PayU Payment Gateway Configuration
VITE_PAYU_MERCHANT_KEY=your_payu_key
VITE_PAYU_SALT=your_payu_salt
VITE_PAYU_BASE_URL=https://secure.payu.in/_payment

# Shiprocket Configuration
VITE_SHIPROCKET_EMAIL=your_shiprocket_email
VITE_SHIPROCKET_PASSWORD=your_shiprocket_password

# API Base URL (for email notifications via suganshop-api)
# If you deploy the API server, set this to its public URL
# VITE_API_BASE_URL=http://localhost:3001

# AI Chat assistant endpoint.
# In production this defaults to /api/chat (Firebase Hosting rewrite -> chat function).
# For local dev against the functions emulator, point it at the emulator URL, e.g.:
# VITE_CHAT_ENDPOINT=http://127.0.0.1:5001/<your-project-id>/us-central1/chat
