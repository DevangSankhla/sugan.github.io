rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users can read/write their own data. `isAdmin` cannot be self-elevated:
    // it may only be created as `true` for allowlisted admin emails, and
    // regular updates by the owner must not change it.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read: if isAdmin();

      allow create: if isSignedIn() && request.auth.uid == userId &&
        (request.resource.data.isAdmin == false ||
         (request.resource.data.isAdmin == true &&
          request.auth.token.email in ['sac280422@gmail.com', 'artisandevang1234@gmail.com']));

      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.isAdmin == resource.data.isAdmin;

      allow update, delete: if isAdmin();
    }

    // Users can read their own orders, admin can read all.
    // Guest orders (userId == null) are readable by anyone who knows the orderId
    // (orderId is a non-guessable Firestore UUID), and also by signed-in users
    // whose email matches the guestEmail on the order.
    match /orders/{orderId} {
      // Authenticated users read their own orders
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow read: if isAdmin();
      // Signed-in users can read guest orders that belong to their email
      allow read: if isSignedIn() && resource.data.userId == null &&
        resource.data.guestEmail == request.auth.token.email;
      // Anyone can read guest orders (non-guessable orderId makes this safe)
      allow read: if resource.data.userId == null;

      // Authenticated users create their own orders
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      // Anyone can create guest orders (no userId)
      allow create: if request.resource.data.userId == null;

      // Owner updates payment/shipping fields only
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.userId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.shippingAddress == resource.data.shippingAddress &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'paymentMethod', 'txnid', 'paidAmount',
                    'paidAt', 'errorMessage', 'updatedAt',
                    'shippingDetails', 'status', 'shippedAt']);

      // Guest order payment status updates (no auth required — orderId is non-guessable)
      allow update: if resource.data.userId == null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'paymentMethod', 'txnid', 'paidAmount',
                    'paidAt', 'errorMessage', 'updatedAt']);

      // Signed-in user claims ownership of their guest order (links it to account)
      allow update: if isSignedIn() &&
        resource.data.userId == null &&
        resource.data.guestEmail == request.auth.token.email &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'updatedAt']);

      allow update: if isAdmin();
    }

    // Users can read/write their own wishlist
    match /wishlists/{wishlistId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    // Products - anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Order number counter - open write so guest orders also get sequential SO# numbers
    match /counters/{counterId} {
      allow read: if true;
      allow write: if true;
    }

    // Promotions - readable by all, customers can only decrement by 1
    match /promotions/{promoId} {
      allow read: if true;
      allow update: if (
        (request.resource.data.remaining == resource.data.remaining - 1 &&
         request.resource.data.remaining >= 0) ||
        isAdmin()
      );
      allow create, delete: if isAdmin();
    }

    // Contact/Bulk Order Submissions - anyone can submit, only admin can read/update
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Affiliate / referral system
    // -------------------------------------------------------------------

    // Influencer codes — public read so checkout can validate. No PII stored
    // here. Admin manages.
    match /affiliateCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PII-free mirror of orders that used an affiliate code. Influencer can
    // read only docs where their email matches affiliateEmail. Only Cloud
    // Functions write (admin SDK bypasses rules).
    match /affiliateOrders/{orderId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.affiliateEmail == request.auth.token.email
      );
      allow write: if false;
    }

    // Monthly settled rollups per affiliate. Influencer reads only their own.
    // Only Cloud Functions write.
    match /affiliateMonthly/{email}/months/{month} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.email == email
      );
      allow write: if false;
    }
  }
}
